FROM golang:1.25-bookworm AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN GOOS=linux GOARCH=amd64 CGO_ENABLED=0 go build -o /bootstrap ./cmd/migrationrunner

FROM public.ecr.aws/lambda/provided:al2023
COPY --from=build /bootstrap ${LAMBDA_TASK_ROOT}/bootstrap
COPY migrations/ ${LAMBDA_TASK_ROOT}/migrations/
CMD ["bootstrap"]
